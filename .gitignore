# The plugin itself has zero runtime dependencies; the Remotion art project
# under art/ has its own (ignored) node_modules and render output.
node_modules/
art/node_modules/
art/out/

# Editor / OS cruft.
.DS_Store
*.swp
*.swo

# Python cache from scripts/dev/pty-smoke.py.
__pycache__/
*.pyc

# Local scratch/test output some contributors keep next to the repo.
/.local-test/
*.log

# Rendered launch-video artefacts (regenerable: npm run make-music, then
# art/ `npm run render:launch` and scripts/dev/verify-launch.py). Kept out of
# the repo so a marketplace install stays small.
docs/launch.mp4
docs/launch-v2.mp4
docs/launch-v3.mp4
docs/review/
docs/review-v2/
docs/review-v3/
art/public/launch-track.wav
art/public/launch-track-v2.wav
art/public/launch-track-v3.wav

# Local brainstorm-server state (holds a session key). Never commit.
.superpowers/
